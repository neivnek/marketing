# ====================================================================
#   Hybrid Zero-Cost Video Pipeline v3.0 — .env.example
#   Copy this file to ".env" and fill in your values.
# ====================================================================

# ── Google AI Studio (Gemini Flash) ──────────────────────────────
# Required for Mode 1 (Auto) + FB Shorts Generative
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...your_key_here

# ── Pexels API (Creative Commons Video Search) ───────────────────
# Required for FB Shorts Remix sub-mode
# Free key (250 req/hour): https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here

# ── Pixabay API (Optional Video Search) ──────────────────────────
# Optional fallback for Mode 7 (Pro Editor)
# Free key: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_key_here

# ── YouTube Data API v3 (Optional Product Research) ────────────────────
# Optional: Mode 7 Product Intelligence Step 0c (search_related_videos)
# Free 10,000 units/day (search.list = 100 units per call ~= 100 searches/day)
# Get key (free, no credit card, 5 minutes):
#   https://console.cloud.google.com -> Enable YouTube Data API v3 -> Create API Key
YOUTUBE_API_KEY=your_youtube_api_key_here
